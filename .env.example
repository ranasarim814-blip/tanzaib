# Copy to .env.local and fill in. Never commit .env files.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international format (also editable in Admin → Settings)
NEXT_PUBLIC_WHATSAPP=+923000000000

# --- Supabase (Project Settings → API) ----------------------------------
# Leave these empty to run in demo mode (in-memory data, nothing saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret! Server-only. Never expose it in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin --------------------------------------------------------------
# The first admin account (used by `pnpm create-admin`; new-order emails go here)
ADMIN_EMAIL=you@example.com
# Long random string used to sign sessions and hash IPs: `openssl rand -hex 32`
SESSION_SECRET=
# Demo mode only (no Supabase): password for ADMIN_EMAIL to open /admin.
DEMO_ADMIN_PASSWORD=

# --- Email (optional) — Resend new-order notifications ---------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Tanzaib <orders@tanzaib.pk>"
RESEND_FROM=

# --- Analytics (optional, off when empty) ---------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
